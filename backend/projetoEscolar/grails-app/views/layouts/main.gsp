<main class="conteudo">
    <g:if test="${ flash.message }">
       <div class="alerta sucesso">
            ${flash.message}
       </div>
    </g:if>

    <g:if test="${ flash.error }">
       <div class="alerta erro">
            ${flash.error}
       </div>
    </g:if>

    <g:layoutBody/>
</main>

<asset:javascript src="application.js"/>

</body>
</html>